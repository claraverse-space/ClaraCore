# Use AMD Strix Halo Vulkan toolbox image for latest APU support
FROM kyuz0/amd-strix-halo-toolboxes:vulkan-radv

# Set working directory
WORKDIR /app

# Copy only the JarvisCore binary
COPY jarviscore /app/jarviscore

# Make it executable
RUN chmod +x /app/jarviscore

# Expose port
EXPOSE 5890

# Set the entrypoint
ENTRYPOINT ["/app/jarviscore"]
CMD ["-listen", "0.0.0.0:5890"]
