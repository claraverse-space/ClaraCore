# Use llama.cpp's official CPU-only server image
FROM ghcr.io/ggml-org/llama.cpp:server

# Set working directory
WORKDIR /app

# Copy only the JarvisCore binary
COPY jarviscore /app/jarviscore

# Make it executable
RUN chmod +x /app/jarviscore

# Expose port
EXPOSE 5890

# Set the entrypoint
ENTRYPOINT ["/app/jarviscore"]
CMD ["-listen", "0.0.0.0:5890"]
